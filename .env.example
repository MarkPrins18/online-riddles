# Supabase project (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (optional). Used for absolute URLs in robots.txt,
# sitemap.xml, and Open Graph metadata (app/robots.ts, app/sitemap.ts,
# app/layout.tsx). Defaults to http://localhost:3000 when unset — set this
# to your real deployment domain (e.g. https://detectivenights.app) once
# one is chosen.
NEXT_PUBLIC_SITE_URL=

# Admin puzzle-import API (see README.md#puzzle-content-story-packs)
ADMIN_IMPORT_SECRET=

# Error monitoring (optional — see README.md#monitoring--error-tracking).
# Leave empty to fall back to structured console/log-based error reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
